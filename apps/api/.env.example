NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://saas_app:local-development-only@localhost:5433/saas_dev?schema=public
DATABASE_TEST_URL=postgresql://saas_app:local-development-only@localhost:5433/saas_test?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes-before-use
AUTH_JWT_ISSUER=unified-inbox-api
AUTH_JWT_AUDIENCE=unified-inbox-clients
AUTH_COOKIE_SECURE=false
SWAGGER_ENABLED=true
LOG_LEVEL=info
