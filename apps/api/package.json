{
  "name": "@saas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"test/**/*.integration.test.ts\"",
    "test:integration": "vitest run test/health.integration.test.ts --maxWorkers=1 --no-file-parallelism",
    "test:database": "node scripts/run-database-tests.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:connect": "tsx scripts/check-database.ts",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/websockets": "12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@saas/shared-types": "workspace:*",
    "@saas/validation": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.4"
  }
}
