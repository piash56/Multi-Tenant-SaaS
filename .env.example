# Local Docker Compose only. Replace every value outside local development.
POSTGRES_DB=saas_dev
POSTGRES_USER=saas_app
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5433
REDIS_PORT=6379

# Host processes use localhost and published ports.
DATABASE_URL=postgresql://saas_app:local-development-only@localhost:5433/saas_dev?schema=public
DATABASE_TEST_URL=postgresql://saas_app:local-development-only@localhost:5433/saas_test?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3001
WEB_PORT=3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes-before-use
AUTH_JWT_ISSUER=unified-inbox-api
AUTH_JWT_AUDIENCE=unified-inbox-clients
AUTH_COOKIE_SECURE=false
SWAGGER_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
LOG_LEVEL=info
